{
  "name": "@sdd/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "bootstrap": "bun src/bootstrap.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --target bun --outdir dist --external playwright-core && bun scripts/build-cli.ts"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.16",
    "@sdd/agent-cli": "workspace:*",
    "@sdd/ai": "workspace:*",
    "@sdd/auth": "workspace:*",
    "@sdd/config": "workspace:*",
    "@sdd/contracts": "workspace:*",
    "@sdd/db": "workspace:*",
    "@sdd/mcp": "workspace:*",
    "@sdd/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "htmlparser2": "^10.1.0",
    "lucide": "^1.48.0",
    "playwright-core": "1.63.0"
  }
}
