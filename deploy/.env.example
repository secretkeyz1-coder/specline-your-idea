# ── Agentic SDD Control Plane — PRODUCTION (VPS) ─────────────────────────────
# Copy to deploy/.env and fill every value before starting the stack:
#   cp deploy/.env.example deploy/.env
#   nano deploy/.env
# Generate secrets with:  openssl rand -base64 32

# Where Caddy listens. While testing with the VPS IP:
#   SITE_ADDRESS=:80
# With a DNS A-record pointing to the VPS (automatic Let's Encrypt TLS):
#   SITE_ADDRESS=https://sdd.example.com
SITE_ADDRESS=:80

# The single public origin users browse to (must match SITE_ADDRESS host).
PUBLIC_WEB_URL=http://localhost

# PostgreSQL credentials (set inside the compose network; change the password!)
POSTGRES_USER=sdd
POSTGRES_PASSWORD=
POSTGRES_DB=sdd

# Instance master key for encrypted provider credentials (AES-256-GCM).
# *** If you lose this, stored AI provider credentials become undecryptable. ***
SDD_MASTER_KEY=

# Browser session signing secret.
SDD_SESSION_SECRET=

# Account sign-up. Closed by default in production: a server on a public domain
# should not give accounts to anyone on the internet. Let your team in with the
# allowlist (emails and/or @domains, comma-separated), e.g.:
#   REGISTRATION_ALLOWLIST=ani@kantor.com,@kantor.com
ALLOW_SELF_REGISTRATION=false
REGISTRATION_ALLOWLIST=
