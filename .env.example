# ── Agentic SDD Control Plane — development environment ──────────────────────
# Copy to .env for local development. Never commit real values.

# PostgreSQL (docker compose up -d postgres)
DATABASE_URL=postgres://sdd:sdd@localhost:5432/sdd

# Instance master key for encrypted provider credentials (AES-256-GCM).
# Supplied OUTSIDE PostgreSQL (docs/13_SECURITY.md §12). Generate with:
#   openssl rand -base64 32
SDD_MASTER_KEY=changeme-generate-a-32-byte-base64-key

# Browser session signing secret (generate like above)
SDD_SESSION_SECRET=changeme-generate-a-random-secret

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000

# Web (SvelteKit)
WEB_PUBLIC_URL=http://localhost:5173
# Where the web app server finds the API (server-side only; the browser never
# calls the API directly). Must NOT be PUBLIC_-prefixed: SvelteKit strips
# PUBLIC_* from $env/dynamic/private, so PUBLIC_API_URL would be silently ignored.
# Reuses the API_PUBLIC_URL value above — keep them identical.

# Logging: debug | info | warn | error
LOG_LEVEL=info

# UI reference render check: each drawn screen is laid out in a headless
# Chromium at phone and desktop width and measured (overflow, hidden table
# columns, page length, small controls). auto (default): on when playwright-core
# and a Chromium are found; off: HTML lint only. UX_RENDER_CHROMIUM points at a
# Chromium executable when it is not in the Playwright browser cache.
UX_RENDER_LINT=auto
# UX_RENDER_CHROMIUM=

# Client IP source for rate limiting (auth brute-force protection).
# false (default): use the socket peer address; x-forwarded-for is ignored.
# true : trust the LAST x-forwarded-for hop — enable ONLY behind a proxy you
#        control (e.g. the reference Caddy deployment).
SDD_TRUST_PROXY=false

# false (default, hosted posture): loopback/private/metadata targets are refused.
# true  (self-hosted opt-in): LAN model endpoints such as Ollama are allowed.
ALLOW_PRIVATE_AI_EGRESS=false

# Local CLI models. A provider connection of type "Local CLI" uses a coding-agent
# CLI (Claude Code, Codex) and its own login instead of an API key.
# true: the CLI may run ON THIS SERVER as the API's OS user (fine for a local
# install; think twice on a shared server). Running the CLI on your own machine
# through sdd-agent works without this.
SDD_ENABLE_LOCAL_CLI=false

# Interface the API listens on. Empty: 127.0.0.1 in development (only this
# machine), 0.0.0.0 in production (inside the container network, behind Caddy).
# Set 0.0.0.0 in development only if an agent on another LAN machine must connect.
API_HOST=

# Account sign-up. Empty: open in development, CLOSED in production.
# Keep it closed on a public domain; let your team in with the allowlist
# (emails and/or @domains, comma-separated).
ALLOW_SELF_REGISTRATION=
REGISTRATION_ALLOWLIST=

# Optional first-run bootstrap (creates operator + workspace when the DB is empty)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_WORKSPACE=Default
